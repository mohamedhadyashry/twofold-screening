rules_version = '2';

// Twofold access rules.
// - Only the site admin(s) can start a review. The first person to sign in claims the site;
//   more admins can be added later by editing config/admins in the Firebase console.
// - A review is visible only to the Google accounts whose email the lead added.
// - Only the lead sees all records, duplicates, the assignment plan and final decisions.
// - Each reviewer reads only the papers assigned to them and only their own decisions.
// - The lead can read everyone's decisions only after turning blind mode off;
//   while blind, the lead only sees which papers each reviewer has screened.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function proj(pid) { return get(/databases/$(database)/documents/projects/$(pid)).data; }
    function isMember(pid) { return signedIn() && myEmail() in proj(pid).emails; }
    function isOwner(pid) { return signedIn() && proj(pid).owner == request.auth.uid; }
    function revealed(pid) { return proj(pid).blind == false; }
    function isAdmin() { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids; }

    match /config/admins {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uids == [request.auth.uid];
    }

    match /projects/{pid} {
      allow read: if signedIn() && myEmail() in resource.data.emails;
      allow create: if isAdmin()
        && request.resource.data.owner == request.auth.uid
        && myEmail() in request.resource.data.emails
        && request.resource.data.blind == true;
      // The lead edits everything (but cannot hand the review away or remove themselves);
      // a reviewer may only update their own entry in `members` (name and progress).
      allow update: if signedIn() && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && myEmail() in request.resource.data.emails)
        || (myEmail() in resource.data.emails
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /chunks/{chunk} {
        allow read, write: if isOwner(pid);
      }
      match /meta/{doc} {
        allow read, write: if isOwner(pid);
      }
      match /assign/{email} {
        allow read: if isOwner(pid) || (isMember(pid) && email == myEmail());
        allow write: if isOwner(pid);
        match /parts/{part} {
          allow read: if isOwner(pid) || (isMember(pid) && email == myEmail());
          allow write: if isOwner(pid);
        }
      }
      // Which papers each reviewer has screened, without the decisions, so the lead can follow progress while blind.
      match /progress/{uid} {
        allow read: if isOwner(pid) || (isMember(pid) && request.auth.uid == uid);
        allow write: if isMember(pid) && request.auth.uid == uid;
        allow delete: if isOwner(pid);
      }
      match /decisions/{uid} {
        allow read: if isMember(pid) && (request.auth.uid == uid || (isOwner(pid) && revealed(pid)));
        allow create, update: if isMember(pid) && request.auth.uid == uid;
        allow delete: if isMember(pid) && (request.auth.uid == uid || isOwner(pid));
      }
    }
  }
}
